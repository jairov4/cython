# mode: run
# tag: value_type, dataclass, optimization, infer_noexcept
# Asserts the value_type codegen contract: hot compiled functions stack-build
# value structs (no heap alloc / tp_new / PyObject_Call), pass them by value,
# dispatch operators through the value-ABI dunder, embed the value struct in the
# objstruct, emit the box converter, and -- with infer_noexcept -- drop the
# post-call exception check on the value ctor / __add__ hot path.

PYTHON cythonize_mod.py
PYTHON check_codegen.py vt.c
PYTHON build_mod.py vt
PYTHON run_test.py

######## cythonize_mod.py ########

import sys
from Cython.Build.Cythonize import main
sys.argv[0] = 'cythonize.py'
main(['-f', '-X', 'infer_noexcept=True', '-X', 'language_level=3', 'vt.pyx'])

######## build_mod.py ########

import sys, os, sysconfig, subprocess

inc = sysconfig.get_paths()['include']
ldshared = sysconfig.get_config_var('LDSHARED') or ''
ext = sysconfig.get_config_var('EXT_SUFFIX') or '.so'

for mod in sys.argv[1:]:
    c_file = mod + '.c'
    so_file = mod + ext
    if os.path.exists(so_file):
        os.remove(so_file)
    cmd = f'{ldshared} -O0 -I{inc} {c_file} -o {so_file}'
    ret = subprocess.call(cmd, shell=True)
    if ret != 0:
        print(f'ERROR: failed to build {mod}', file=sys.stderr)
        sys.exit(1)
    print(f'Built {so_file}')

######## check_codegen.py ########

import sys, re

c_path = sys.argv[1]
with open(c_path) as f:
    content = f.read()
lines = content.splitlines()


def function_body(src, signature_fragment):
    """Return the text of the (definition) function whose opening line contains
    signature_fragment and ends with '{', up to the matching closing brace."""
    start = None
    for i, line in enumerate(src.splitlines()):
        if signature_fragment in line and line.rstrip().endswith('{'):
            start = i
            break
    assert start is not None, "function not found: %s" % signature_fragment
    body_lines = []
    depth = 0
    for line in src.splitlines()[start:]:
        body_lines.append(line)
        depth += line.count('{') - line.count('}')
        if depth == 0 and len(body_lines) > 1:
            break
    return '\n'.join(body_lines)


# --- (1) Hot function bodies must be heap-allocation free ------------------
for frag in ('__pyx_f_2vt_make_and_sum(double', '__pyx_f_2vt_add_loop(int'):
    body = function_body(content, frag)
    for bad in ('__Pyx_tp_new', 'tp_new_2vt_Vec2', 'PyObject_Call', '__Pyx_PyObject_Call'):
        assert bad not in body, "unexpected %s in %s body" % (bad, frag)

# --- (2) Value struct passed/returned by value ----------------------------
# make_and_sum / add_loop declare local value structs by value.
add_loop = function_body(content, '__pyx_f_2vt_add_loop(int')
assert '__pyx_val_2vt_Vec2 __pyx_v_acc;' in add_loop, \
    "value struct not stack-allocated by value in add_loop"

# --- (3) objstruct embeds the value struct member -------------------------
assert '__pyx_val_2vt_Vec2 __pyx_value;' in content, \
    "objstruct does not embed __pyx_value member"

# --- (4) box converter emitted -------------------------------------------
assert '__pyx_convert__to_py___pyx_val_2vt_Vec2' in content, \
    "value-class to_py box converter not emitted"

# --- (5) value-ABI dunder dispatch: __add__ called with &<value> ----------
assert re.search(r'__pyx_f_2vt_4Vec2___add__\(\(&', content), \
    "value-ABI __add__ call (taking address of value struct) not found"

# --- (6) infer_noexcept: the hot __add__ call site has no PyErr check -----
m = re.search(r'__pyx_t_\d+ = __pyx_f_2vt_4Vec2___add__\(\(&__pyx_v_acc\)[^\n]*\n([^\n]*)', add_loop)
assert m, "add_loop __add__ call site not found"
follow = m.group(1)
assert 'PyErr_Occurred' not in follow and '__PYX_ERR' not in follow, \
    "unexpected exception check after noexcept value __add__ call:\n%s" % follow

# --- (7) abs(value).method() — abs resolves to __abs__ value-ABI call, no boxing ---
ats = function_body(content, '__pyx_f_2vt_abs_and_total_seconds(__pyx_val_2vt_Duration')
for bad in ('__Pyx_tp_new', 'PyObject_Call', '__Pyx_PyObject_Call'):
    assert bad not in ats, "unexpected %s in abs_and_total_seconds body" % bad
# The __abs__ call must be a direct value-ABI call (address of value struct)
assert re.search(r'pyx_f_2vt_8Duration___abs__\(\(&', ats), \
    "value-ABI __abs__ call (taking address of value struct) not found in abs_and_total_seconds"
# The .total_seconds() call on the __abs__ result must also be a direct value-ABI call
assert re.search(r'pyx_f_2vt_8Duration_total_seconds\(\(&', ats), \
    "value-ABI total_seconds call (taking address of value struct) not found in abs_and_total_seconds"

# --- (8) Cross-value-type reference: datetime.__sub__ must return __pyx_val_...timedelta ---
# Search for the datetime.__sub__ function declaration (value-ABI form)
sub_decl = function_body(content, '___sub__(')
# The return type must be __pyx_val_ (value struct), not struct __pyx_obj_ (boxed)
# The function body should be "struct __pyx_obj_" NOT in the return type position
# Check the proto line for __sub__
import re
# Find the function declaration for datetime.__sub__
for frag in ('__pyx_f_2vt_8datetime___sub__', '8datetime___sub__'):
    if frag in content:
        # Find the line containing the declaration
        for line in lines:
            if frag in line and '__pyx_f_' in line:
                # Assert it returns value struct, not boxed pointer
                assert '__pyx_val_' in line and 'struct __pyx_obj_' not in line, \
                    "datetime.__sub__ return type should be value struct, got:\n%s" % line
                break

# --- (9) Cross-value-type reference: sub_to_seconds uses value-ABI for both calls ---
sub_sec = function_body(content, '__pyx_f_2vt_sub_to_seconds(__pyx_val_2vt_datetime')
for bad in ('__Pyx_tp_new', 'PyObject_Call', '__Pyx_PyObject_Call'):
    assert bad not in sub_sec, "unexpected %s in sub_to_seconds body" % bad
# The __sub__ call must use value-ABI (address of value struct)
assert re.search(r'pyx_f_2vt_8datetime___sub__\(\(&', sub_sec), \
    "value-ABI datetime.__sub__ call not found in sub_to_seconds"

# --- (10) noexcept value-type classmethod called with sparse keywords -------
# timedelta.new is a final (value_type) classmethod whose body cannot raise, so
# infer_noexcept must drop the post-call PyErr check even though the call site
# holds a *copy* of the CFuncType (classmethod cls-injection).  The sparse
# keyword fills must also become a direct C call with the opt-args bitmask.
mts = function_body(content, '__pyx_f_2vt_make_td_sparse(')
new_calls = re.findall(r'__pyx_f_2vt_\d+timedelta_new\([^\n]*\n([^\n]*)', mts)
assert new_calls, "timedelta.new call sites not found in make_td_sparse"
for follow in new_calls:
    assert 'PyErr_Occurred' not in follow and '__PYX_ERR' not in follow, \
        "unexpected exception check after noexcept value classmethod call:\n%s" % follow
# Sparse bitmask: seconds is optional ordinal 1 -> bit 1 (mask 2); days+micros
# are ordinals 0 and 2 -> mask 5.  Both set the opt-args struct's __pyx_n.
assert '__pyx_n = 2U;' in mts, "expected seconds-only bitmask (2U) in make_td_sparse"
assert '__pyx_n = 5U;' in mts, "expected days+micros bitmask (5U) in make_td_sparse"

print("OK: value_type codegen assertions passed")

######## run_test.py ########

import sys
sys.path.insert(0, '.')
import vt

assert vt.make_and_sum(3.0, 4.0) == 7.0, vt.make_and_sum(3.0, 4.0)
assert vt.add_loop(3) == 9.0, vt.add_loop(3)   # 3*(1+2) = 9
assert vt.abs_and_total_seconds(vt.Duration(-1_500_000)) == 1.5, vt.abs_and_total_seconds(vt.Duration(-1_500_000))
assert vt.abs_and_total_seconds(vt.Duration(2_000_000)) == 2.0, vt.abs_and_total_seconds(vt.Duration(2_000_000))
d1 = vt.datetime(2_000_000)
d2 = vt.datetime(500_000)
assert vt.sub_to_seconds(d1, d2) == 1.5, vt.sub_to_seconds(d1, d2)
assert vt.make_td_sparse() == 5_000_000 + (86_400_000_000 + 3), vt.make_td_sparse()
print("DONE: value_type runtime tests passed")

######## vt.pyx ########

# cython: language_level=3
cimport cython
from dataclasses import dataclass


@cython.value_type
@cython.final
@dataclass(frozen=True)
cdef class Vec2:
    x: cython.double
    y: cython.double

    def __add__(self, other: Vec2) -> Vec2:
        return Vec2(self.x + other.x, self.y + other.y)


cpdef double make_and_sum(double a, double b):
    cdef Vec2 v = Vec2(a, b)
    return v.x + v.y


cpdef double add_loop(int n):
    cdef Vec2 acc = Vec2(0.0, 0.0)
    cdef int i
    for i in range(n):
        acc = acc + Vec2(1.0, 2.0)
    return acc.x + acc.y


# --- Duration value class with __abs__ -> value-ABI + method chain ----------

@cython.value_type
@cython.final
@dataclass(frozen=True)
cdef class Duration:
    us: cython.longlong

    def __neg__(self) -> Duration:
        return Duration(-self.us)

    def __abs__(self) -> Duration:
        if self.us < 0:
            return -self
        return self

    def total_seconds(self) -> cython.double:
        return self.us / 1_000_000.0


cpdef double abs_and_total_seconds(Duration d):
    """abs(d).total_seconds() — no boxing, direct value-ABI calls."""
    return abs(d).total_seconds()


# --- Cross-module-like value-type reference: datetime.__sub__ -> timedelta ---
# timedelta is defined AFTER datetime, so datetime's auto-promoted cpdef
# methods must resolve timedelta through the pre-built value shell.

@cython.value_type
@cython.final
@dataclass(frozen=True)
cdef class datetime:
    us: cython.longlong

    def __add__(self, other: timedelta) -> datetime:
        return datetime(self.us + other.us)

    def __sub__(self, other: datetime) -> timedelta:
        return timedelta(self.us - other.us)


@cython.value_type
@cython.final
@dataclass(frozen=True)
cdef class timedelta:
    us: cython.longlong

    def __neg__(self) -> timedelta:
        return timedelta(-self.us)

    def __abs__(self) -> timedelta:
        if self.us < 0:
            return -self
        return self

    @classmethod
    def new(cls, days: cython.longlong = 0, seconds: cython.longlong = 0,
            micros: cython.longlong = 0) -> timedelta:
        return timedelta(days * 86_400_000_000 + seconds * 1_000_000 + micros)


cpdef double sub_to_seconds(datetime d1, datetime d2):
    """(d1 - d2).total_seconds() — cross-value-type reference."""
    cdef timedelta td = d1 - d2
    return td.us / 1_000_000.0


cpdef long long make_td_sparse():
    """timedelta.new(seconds=...) / .new(days=, micros=) — sparse-keyword C calls
    to a noexcept value-type classmethod: bitmask opt-args + no PyErr check."""
    cdef timedelta a = timedelta.new(seconds=5)
    cdef timedelta b = timedelta.new(days=1, micros=3)
    return a.us + b.us
